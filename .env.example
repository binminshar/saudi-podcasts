# Supabase (production storage). Leave empty to store data in .data on disk.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional overrides
# SUPABASE_DOCUMENTS_BUCKET=documents
# SUPABASE_UPLOADS_BUCKET=uploads
# CATALOG_CACHE_SECONDS=30

# First admin account (used only when no account exists yet)
ADMIN_USERNAME=
ADMIN_PASSWORD=
