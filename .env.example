# Supabase storage for production (catalog, admin credentials, uploaded images).
# Leave both empty to keep using the local .data folder.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: first admin account on a fresh deployment (ignored once an account exists).
# Username: 3-40 latin letters/digits. Password: at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
